{
  "keep": ["#page", "#play", "#readout", "#hint"],
  "states": [
    {"name":"copied-page","steps":[{"click":"#copy-page"}]},
    {"name":"bounce-time","steps":[{"click":"#starters"},{"click":"[data-starter=real]"},{"click":"#m-time"}],"sizes":["1366x768","680x425"]},
    {"name":"live-flip","steps":[{"click":"#m-flip"},{"click":"#play"},{"wait":500},{"click":"#play"}]},
    {"name":"starter-library","steps":[{"click":"#starters"}],"keep":[],"sizes":["1366x768","680x425"]},
    {"name":"timing-help","steps":[{"click":"#m-time"},{"click":"#why"}],"keep":[],"sizes":["1366x768"]},
    {"name":"hold-high","steps":[{"click":"#m-time"},{"click":"#hold-plus","times":5}]},
    {"name":"hold-low","steps":[{"click":"#m-time"},{"click":"#hold-minus"}]},
    {"name":"fps-low","steps":[{"click":"#m-time"},{"click":"[data-fps='6']"}],"sizes":["1366x768","680x425"]},
    {"name":"fps-high","steps":[{"click":"#m-time"},{"click":"[data-fps='24']"}],"sizes":["1366x768","680x425"]},
    {"name":"blink-time","steps":[{"click":"#starters"},{"click":"[data-starter=blink]"},{"click":"#m-time"}],"sizes":["1366x768","680x425"]},
    {"name":"drawn-copy","steps":[{"drag":"(()=>{const r=document.querySelector('#paper').getBoundingClientRect();return [[r.x+r.width*.3,r.y+r.height*.4],[r.x+r.width*.5,r.y+r.height*.5]]})()"},{"click":"#copy-page"}],"sizes":["1366x768","680x425"]},
    {"name":"delete-pauses-book","steps":[{"click":"#starters"},{"click":"[data-starter=real]"},{"click":"#play"},{"click":"#delete-page"},{"click":"#cancel"}],"sizes":["1366x768"]},
    {"name":"page-limit","steps":[{"click":"#new-page","times":47,"gap":0.05}],"sizes":["1366x768","680x425"]}
  ]
}
