[
  {
    "id": "1-Maya-a",
    "beat": 0,
    "role": "Maya",
    "text": "Band ran late again. Mr. Ortiz, you waited for me?",
    "seconds": 4.4,
    "tension": 0,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "1-Maya-b",
    "beat": 0,
    "role": "Maya",
    "text": "Last one on the late bus. Like always.",
    "seconds": 3.6,
    "tension": 0,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "1-Ortiz-a",
    "beat": 0,
    "role": "Ortiz",
    "text": "Twelve years I've driven this bus. I always wait for the band kids.",
    "seconds": 5.6000000000000005,
    "tension": 0,
    "need": true,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "1-Ortiz-b",
    "beat": 0,
    "role": "Ortiz",
    "text": "Seat belt, Maya. Long day?",
    "seconds": 2.4,
    "tension": 0,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "1-Dale-a",
    "beat": 0,
    "role": "Dale",
    "text": "Mr. Ortiz, before you go, I need a minute.",
    "seconds": 4.0,
    "tension": 1,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "1-Dale-b",
    "beat": 0,
    "role": "Dale",
    "text": "Good, you're both here. I wish I wasn't.",
    "seconds": 3.6,
    "tension": 1,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "2-Maya-a",
    "beat": 1,
    "role": "Maya",
    "text": "Wait. Cut? Then how do I get home after band?",
    "seconds": 4.4,
    "tension": 2,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "2-Maya-b",
    "beat": 1,
    "role": "Maya",
    "text": "You're joking. Right?",
    "seconds": 1.6,
    "tension": 1,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "2-Maya-c",
    "beat": 1,
    "role": "Maya",
    "text": "...",
    "seconds": 2,
    "tension": 2,
    "need": false,
    "turn": false,
    "offer": 3,
    "silent": true
  },
  {
    "id": "2-Ortiz-a",
    "beat": 1,
    "role": "Ortiz",
    "text": "Starting when?",
    "seconds": 1.2000000000000002,
    "tension": 1,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "2-Ortiz-b",
    "beat": 1,
    "role": "Ortiz",
    "text": "So after Friday, this route is just gone.",
    "seconds": 3.6,
    "tension": 2,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "2-Dale-a",
    "beat": 1,
    "role": "Dale",
    "text": "The district is cutting the late bus. Friday is the last run.",
    "seconds": 5.2,
    "tension": 2,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "2-Dale-b",
    "beat": 1,
    "role": "Dale",
    "text": "The late bus is done after Friday. I just found out.",
    "seconds": 4.800000000000001,
    "tension": 2,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "3-Maya-a",
    "beat": 2,
    "role": "Maya",
    "text": "My mom works nights. If there's no bus, there's no band. For me.",
    "seconds": 5.6000000000000005,
    "tension": 3,
    "need": true,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "3-Maya-b",
    "beat": 2,
    "role": "Maya",
    "text": "I practice every day. I'm finally first chair.",
    "seconds": 3.6,
    "tension": 2,
    "need": true,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "3-Ortiz-a",
    "beat": 2,
    "role": "Ortiz",
    "text": "Those kids are my route. Some of them only talk to me.",
    "seconds": 5.2,
    "tension": 2,
    "need": true,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "3-Ortiz-b",
    "beat": 2,
    "role": "Ortiz",
    "text": "The late run is half my hours.",
    "seconds": 3.1999999999999997,
    "tension": 2,
    "need": true,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "3-Ortiz-c",
    "beat": 2,
    "role": "Ortiz",
    "text": "My own daughter plays trombone. I know what band means.",
    "seconds": 4.4,
    "tension": 2,
    "need": true,
    "turn": false,
    "offer": 1,
    "silent": false
  },
  {
    "id": "3-Dale-a",
    "beat": 2,
    "role": "Dale",
    "text": "I have to cut forty thousand dollars. Every choice hurts someone.",
    "seconds": 4.800000000000001,
    "tension": 2,
    "need": true,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "3-Dale-b",
    "beat": 2,
    "role": "Dale",
    "text": "If I keep the bus, I lose a teacher's aide.",
    "seconds": 4.4,
    "tension": 3,
    "need": true,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "4-Maya-a",
    "beat": 3,
    "role": "Maya",
    "text": "So band only counts for kids whose parents can drive.",
    "seconds": 4.4,
    "tension": 3,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "4-Maya-b",
    "beat": 3,
    "role": "Maya",
    "text": "Did anyone ask the kids who ride it?",
    "seconds": 3.6,
    "tension": 3,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "4-Ortiz-a",
    "beat": 3,
    "role": "Ortiz",
    "text": "You cut the bus and you cut the kids who need it most.",
    "seconds": 5.6000000000000005,
    "tension": 3,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "4-Ortiz-b",
    "beat": 3,
    "role": "Ortiz",
    "text": "Nobody asked me either.",
    "seconds": 2.0,
    "tension": 2,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "4-Dale-a",
    "beat": 3,
    "role": "Dale",
    "text": "You think I wanted this? Show me the money and I'll keep it.",
    "seconds": 5.6000000000000005,
    "tension": 3,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "4-Dale-b",
    "beat": 3,
    "role": "Dale",
    "text": "I don't need a speech. I need a plan.",
    "seconds": 4.0,
    "tension": 3,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "4-Dale-c",
    "beat": 3,
    "role": "Dale",
    "text": "I rode a late bus for six years. Don't tell me I don't know.",
    "seconds": 6.0,
    "tension": 3,
    "need": true,
    "turn": false,
    "offer": 2,
    "silent": false
  },
  {
    "id": "5-Maya-a",
    "beat": 4,
    "role": "Maya",
    "text": "What if we ask? Twenty band kids, one sheet. Who rides and when.",
    "seconds": 5.6000000000000005,
    "tension": 2,
    "need": false,
    "turn": true,
    "offer": 0,
    "silent": false
  },
  {
    "id": "5-Maya-b",
    "beat": 4,
    "role": "Maya",
    "text": "Fine. I'll quit band.",
    "seconds": 2.0,
    "tension": 3,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "5-Maya-c",
    "beat": 4,
    "role": "Maya",
    "text": "Wait. It's not just me. Half the jazz band rides this bus.",
    "seconds": 5.2,
    "tension": 2,
    "need": false,
    "turn": true,
    "offer": 4,
    "silent": false
  },
  {
    "id": "5-Ortiz-a",
    "beat": 4,
    "role": "Ortiz",
    "text": "What if the late run only goes Tuesdays and Thursdays? Half the fuel.",
    "seconds": 5.6000000000000005,
    "tension": 2,
    "need": false,
    "turn": true,
    "offer": 0,
    "silent": false
  },
  {
    "id": "5-Ortiz-b",
    "beat": 4,
    "role": "Ortiz",
    "text": "I could take Maya. Just this week.",
    "seconds": 3.1999999999999997,
    "tension": 1,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "5-Dale-a",
    "beat": 4,
    "role": "Dale",
    "text": "If you can show me the riders, I can take it to the board.",
    "seconds": 6.0,
    "tension": 2,
    "need": false,
    "turn": true,
    "offer": 0,
    "silent": false
  },
  {
    "id": "5-Dale-b",
    "beat": 4,
    "role": "Dale",
    "text": "It's decided. I'm sorry.",
    "seconds": 2.0,
    "tension": 3,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "6-Maya-a",
    "beat": 5,
    "role": "Maya",
    "text": "Tuesday. Same seat.",
    "seconds": 1.6,
    "tension": 0,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "6-Maya-b",
    "beat": 5,
    "role": "Maya",
    "text": "I'll have the sheet by lunch.",
    "seconds": 2.8,
    "tension": 1,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "6-Ortiz-a",
    "beat": 5,
    "role": "Ortiz",
    "text": "Seat belt, Maya.",
    "seconds": 1.6,
    "tension": 0,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "6-Ortiz-b",
    "beat": 5,
    "role": "Ortiz",
    "text": "Twelve years. Let's make it thirteen.",
    "seconds": 2.8,
    "tension": 0,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "6-Dale-a",
    "beat": 5,
    "role": "Dale",
    "text": "Board meets Monday. Bring the sheet.",
    "seconds": 2.8,
    "tension": 1,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  },
  {
    "id": "6-Dale-b",
    "beat": 5,
    "role": "Dale",
    "text": "Go home, both of you. We'll fix what we can.",
    "seconds": 4.4,
    "tension": 0,
    "need": false,
    "turn": false,
    "offer": 0,
    "silent": false
  }
]