{
  "keep": [
    "#range",
    "#graph",
    "#hint",
    "#go"
  ],
  "states": [
    {
      "name": "factor-work",
      "steps": [
        {
          "click": "#m-missions"
        },
        {
          "click": "#check"
        },
        {
          "click": "#target"
        },
        {
          "js": "document.querySelector('#target').value='0';"
        },
        {
          "click": "#check"
        }
      ],
      "keep": [
        "#methods",
        "#fields",
        "#check"
      ]
    },
    {
      "name": "square-work",
      "steps": [
        {
          "click": "#m-missions"
        },
        {
          "click": "#check"
        },
        {
          "click": "#target"
        },
        {
          "js": "document.querySelector('#target').value='0';"
        },
        {
          "click": "#check"
        },
        {
          "click": "[data-method=\"Complete the square\"]"
        }
      ],
      "keep": [
        "#methods",
        "#fields",
        "#check"
      ]
    },
    {
      "name": "formula-coefficients",
      "steps": [
        {
          "click": "#m-missions"
        },
        {
          "click": "#check"
        },
        {
          "click": "#target"
        },
        {
          "js": "document.querySelector('#target').value='0';"
        },
        {
          "click": "#check"
        },
        {
          "click": "[data-method=\"Formula\"]"
        }
      ],
      "keep": [
        "#methods",
        "#fields",
        "#check"
      ]
    },
    {
      "name": "answer-and-two-crossings",
      "steps": [
        {
          "click": "#m-missions"
        },
        {
          "js": "const s=document.querySelector('#mission-select');s.value='3';s.dispatchEvent(new Event('change',{bubbles:true}));"
        },
        {
          "click": "#check"
        },
        {
          "click": "#target"
        },
        {
          "js": "document.querySelector('#target').value='48';"
        },
        {
          "click": "#check"
        },
        {
          "click": "#p"
        },
        {
          "js": "document.querySelector('#p').value='1';"
        },
        {
          "click": "#q"
        },
        {
          "js": "document.querySelector('#q').value='3';"
        },
        {
          "click": "#check"
        },
        {
          "click": "#answer-input"
        },
        {
          "js": "document.querySelector('#answer-input').value='1,3';"
        },
        {
          "click": "#check"
        },
        {
          "click": "#go"
        },
        {
          "until": "!__tool.state.running",
          "max": 9000
        }
      ],
      "keep": [
        "#work",
        "#go",
        "#telemetry"
      ]
    },
    {
      "name": "speed-upper-limit",
      "steps": [
        {
          "click": "#slider-v"
        },
        {
          "drag": "const r=document.querySelector('#slider-v').getBoundingClientRect();return [[r.x+10,r.y+r.height/2],[r.right-2,r.y+r.height/2]];"
        }
      ],
      "keep": [
        "#explore",
        "#go"
      ]
    },
    {
      "name": "height-upper-limit",
      "steps": [
        {
          "click": "#slider-h"
        },
        {
          "drag": "const r=document.querySelector('#slider-h').getBoundingClientRect();return [[r.x+10,r.y+r.height/2],[r.right-2,r.y+r.height/2]];"
        }
      ],
      "keep": [
        "#explore",
        "#go"
      ]
    },
    {
      "name": "line-upper-limit",
      "steps": [
        {
          "click": "#slider-H"
        },
        {
          "drag": "const r=document.querySelector('#slider-H').getBoundingClientRect();return [[r.x+10,r.y+r.height/2],[r.right-2,r.y+r.height/2]];"
        }
      ],
      "keep": [
        "#explore",
        "#go"
      ]
    },
    {
      "name": "general-formula-derivation",
      "steps": [
        {
          "click": "#m-missions"
        },
        {
          "js": "__tool.mission(7)"
        },
        {
          "click": "#check"
        },
        {
          "js": "document.querySelector('#target').value='0'"
        },
        {
          "click": "#check"
        },
        {
          "click": "[data-method=\"Complete the square\"]"
        },
        {
          "js": "document.querySelector('#k').value='3/2';document.querySelector('#m').value='41/16'"
        },
        {
          "click": "#check"
        }
      ],
      "keep": [
        "#fields",
        "#check",
        "#work-equation"
      ]
    },
    {
      "name": "complex-roots",
      "steps": [
        {
          "click": "#m-missions"
        },
        {
          "js": "const s=document.querySelector('#mission-select');s.value='5';s.dispatchEvent(new Event('change',{bubbles:true}));"
        },
        {
          "click": "#check"
        },
        {
          "js": "document.querySelector('#target').value='80'"
        },
        {
          "click": "#check"
        },
        {
          "click": "[data-method=\"Formula\"]"
        },
        {
          "js": "document.querySelector('#a').value='1';document.querySelector('#b').value='-4';document.querySelector('#c').value='5'"
        },
        {
          "click": "#check"
        },
        {
          "js": "document.querySelector('#real-count').value='0'"
        },
        {
          "click": "#check"
        }
      ],
      "keep": [
        "#fields",
        "#check",
        "#work-equation"
      ]
    }
  ]
}
