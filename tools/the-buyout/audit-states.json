        "1366x768",
        "375x812"
      ]
    },
    {
      "name": "maximum-evidence",
      "steps": [
        {
          "js": "for(const id of ['m-compare','finish-rivals','finish-buyout'])document.getElementById(id).click();for(const [g,v] of [['rivals',1],['buyout',2],['buyers',0]])document.querySelector('[data-rating=\"'+g+'\"][data-value=\"'+v+'\"]').click();document.getElementById('switch-test').click();for(const k of ['price','served','gain'])document.querySelector('[data-measure=\"'+k+'\"]').click();for(const id of ['m-regulator','remedy-1','remedy-4','view-buyers','view-everyone','tab-memo'])document.getElementById(id).click();const e=document.getElementById('first-remedy');e.value='1';e.dispatchEvent(new Event('change',{bubbles:true}));document.querySelector('[data-memo-step=\"1\"]').click();"
        }
      ],
      "keep": [
        "#evidence-chips"
      ],
      "sizes": [
        "680x425",
        "1366x768",
        "375x812"
      ]
    }
