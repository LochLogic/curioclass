    return None


def course_gates(c):
    g = [('plan-' + c, ['scripts/plan.py', 'check', c]), ('lesson-' + c, ['scripts/lesson_course.py', c]),
         ('unitplan-' + c, ['scripts/unitplan.py', 'check', c]), ('lint-' + c, ['scripts/lint.py', '--course', c])]
    s = subject_ledger(c)
    if s:
