    c=[x.strip() for x in line.strip('|').split('|')]
    if len(c)==11 and c[0].isdigit(): units.append(c)
rows=[r for r in csv.DictReader(Path('data/progressions/sel.csv').open(encoding='utf-8')) if r['grade'] in ['6','7','8']]
placed=collections.Counter(x.strip() for u in units for x in u[4].split(';'))
