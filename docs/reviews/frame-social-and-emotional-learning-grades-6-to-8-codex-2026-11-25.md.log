    print('YEAR',grade,'units',len(us),'days',sum(int(u[3]) for u in us),'rows',sum(len(u[4].split(';')) for u in us),'owners',sum(len([x for x in u[5].split(';') if x.strip()]) for u in us))
cal=list(csv.DictReader(Path('data/plans/calendar.csv').open(encoding='utf-8')))
for r in cal:
    if r['course']==course: print('CAL',r)
core=[r for r in cal if r['grade'] in ['6','7','8'] and r['subject'] in ['ela','math','science','social-studies'] and r['kind']"'!='"'unit']
for r in cal:
    if r['course']==course and r['kind']=='check':
        lo,hi=int(r['first_school_day']),int(r['last_school_day'])
        collisions=[(x['course'],x['kind'],x['first_school_day'],x['last_school_day']) for x in core if x['grade']==r['grade'] and x['kind']=='check' and max(lo,int(x['first_school_day']))<=min(hi,int(x['last_school_day']))]
        print('COLLISIONS',r['grade'],r['label'],collisions)
print('LIBRARY FILES',[(str(p),p.exists()) for p in [Path('data/plans/library-excluded.csv'),Path('data/progressions/library-excluded.csv')]])
