import re,csv
frame=Path('docs/courses/social-and-emotional-learning-grades-6-to-8/frame.md').read_text(encoding='utf-8')
leans=set(re.findall(r'(?:ela|math|social-studies):([a-z0-9-]+)',frame))
for c in csv.DictReader(Path('data/plans/course-list.csv').open(encoding='utf-8')):
    if c['subject'] not in ['ela','math','social-studies'] or c['grade'] not in ['6','7','8']: continue
    p=Path('docs/courses')/c['id']/'frame.md'
    if not p.exists(): continue
    for line in p.read_text(encoding='utf-8').splitlines():
        cells=[x.strip() for x in line.strip('|').split('|')]
        if cells[0].isdigit() and leans.intersection(re.findall(r'\\b(?:e|m|ss)[a-z0-9-]+',line)):
            print(c['id']+' | '+line)
