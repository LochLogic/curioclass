def tables(course):
    changed = 0
    for f in sorted((DOCS / course).glob('*.md')):
        m = re.match(r'([su])(\d+)(?:-(\d+))?', f.name)
        if not m:
            continue
        raw = io.open(f, encoding='utf-8', newline='').read()
        nl = '\r\n' if '\r\n' in raw else '\n'
        b = blocks(course, str(int(m[2])), '%d.%s' % (int(m[2]), m[3]) if m[1] == 'u' and m[3] else None)
        def sub(mm):
            name = mm.group(1)
            if name not in b:
                raise SystemExit('%s: unknown generated block "%s"' % (f.name, name))
            return '<!-- gen:%s (from data/plans/%s; do not edit here) -->%s%s%s<!-- /gen -->' % (
                name, course, nl, b[name].replace('\n', nl), nl)
        new = re.sub(r'<!-- gen:([a-z-]+)[^>]*-->.*?<!-- /gen -->', sub, raw, flags=re.S)
        if new != raw:
            io.open(f, 'w', encoding='utf-8', newline='').write(new); changed += 1
            print('rewrote', f.relative_to(ROOT))
    print('%d file(s) changed' % changed)


# ------------------------------------------------------------------ reading pack
def pack(course, s):
    out = ['# Reading pack: %s, unit %s' % (course, s), '',
           'Built by scripts/plan.py on %s. Everything a writer or reader of this unit needs, and nothing else.' % datetime.date.today(),
           'Read in full first: docs/FOUNDATION.md, docs/courses/UNIT-PLAN.md (the rules), and for a lesson writer',
           'docs/courses/LESSON-DAY.md.', '']
    parts = [p for p in rows(course, 'parts') if p['stretch'] == s]
    items = [i for i in rows(course, 'items') if i['stretch'] == s]
    wanted = sorted({p['code'] for p in parts} | {i['code'] for i in items})
    std = ROOT / 'data' / 'standards' / 'ccss-math-standards.txt'
    out.append('## The standards, in their own words\n')
    if std.exists():
        for l in std.read_text(encoding='utf-8').splitlines():
            if l.split('\t')[0] in wanted:
                out.append('- **%s** %s' % tuple(l.split('\t')[:2]))
    b = blocks(course, s)
    for title, k in [('Parts of each standard this unit must teach and check', 'parts'), ('Days', 'days'),
                     ('Readiness check', 'readiness'), ('End-of-unit assessment', 'end-check'), ('Exit questions', 'exits'),
                     ('Error register', 'errors')]:
        out += ['', '## ' + title, '', b[k]]
    tools = sorted({d.get('tool', '') for d in rows(course, 'days') if d['stretch'] == s and d.get('tool')})
    asks = DOCS / course / 'TOOL-ASKS.md'
    if tools and asks.exists():
        text = asks.read_text(encoding='utf-8')
        for t in tools:
            name = t.replace('-', ' ').title()
            m = re.search(r'^## %s.*?(?=^## |\Z)' % re.escape(name), text, flags=re.S | re.M)
            out += ['', '## Tool asks: ' + name, '', m.group(0).split('\n', 1)[1].strip() if m else '(no section in TOOL-ASKS.md)',
                    '', 'Spec: tools/%s/spec.md' % t]
    for f in [DOCS / course / ('s%02d.md' % int(s))] + sorted((DOCS / course).glob('u%02d-*.md' % int(s))):
        if f.exists():   # the unit plan, then each section plan: a day writer needs the section's prose too
            prose = re.sub(r'<!-- gen:.*?<!-- /gen -->', '(table above)', plan_read(f), flags=re.S)
            out += ['', '## The plan\'s prose (%s)' % f.name, '', prose]
    open_d = [d for d in rows_defects() if d['course'] == course and d['status'] == 'open' and ('s%02d' % int(s)) in d['artifact']]
    if open_d:
        out += ['', '## Open defects on this unit', ''] + ['- %s (%s, %s): %s' % (d['artifact'], d['found_by'], d['date'], d['summary']) for d in open_d]
    print('\n'.join(out))


# ------------------------------------------------------------------ defect ledger
DEF = PLANS / 'defects.csv'
DEF_COLS = ['date', 'course', 'artifact', 'layer', 'found_by', 'kind', 'summary', 'status', 'ref', 'made_at']
MADE_AT = {'prework', 'progression', 'frame', 'scope', 'unit-plan', 'section-plan', 'plan-data', 'keys', 'day', 'finish', 'kit'}
# made_at (COURSE-RUN section 4): the stage that made the fault, beside found_by/layer, the stage that found it; old rows blank


def rows_defects():
    with io.open(DEF, encoding='utf-8', newline='') as f:
        return list(csv.DictReader(f))


def defect_add(a):
    status = 'open'
    made_at = ''
    for x in [x for x in a if x.startswith('--made-at=')]:
        made_at = x.split('=', 1)[1]
        a = [y for y in a if y != x]
    if made_at and made_at not in MADE_AT:
        raise SystemExit('made_at must be one of: ' + ', '.join(sorted(MADE_AT)))
    for x in [x for x in a if x.startswith('--status=')]:
        status = x.split('=', 1)[1]
        a = [y for y in a if y != x]
    if status not in ('open', 'fixed', 'rejected'):
        raise SystemExit('status must be open, fixed or rejected')
    if len(a) < 6:
        raise SystemExit(__doc__)
    if a[3] not in READERS:
        raise SystemExit('found_by must be one of: ' + ', '.join(sorted(READERS)))
    row = [str(datetime.date.today())] + a[:6] + [status, a[6] if len(a) > 6 else '', made_at]
    with io.open(DEF, encoding='utf-8', newline='') as f:   # an old file lacks the made_at column: add it, old rows blank
        head = next(csv.reader(f), [])
    if head and 'made_at' not in head:
        old = rows_defects()
        with io.open(DEF, 'w', encoding='utf-8', newline='') as f:
            w = csv.writer(f, lineterminator=chr(10))
            w.writerow(head + ['made_at'])
            for r in old:
                w.writerow([r.get(h, '') for h in head] + [''])
    with io.open(DEF, 'a', encoding='utf-8', newline='') as f:
        csv.writer(f, lineterminator='\n').writerow(row)
    print('logged:', row)


def defects():
    d = rows_defects()
    print('%d defects logged, %d open' % (len(d), sum(1 for x in d if x['status'] == 'open')))
    tally = {}
    for x in d:
        tally[(x['found_by'], x['layer'])] = tally.get((x['found_by'], x['layer']), 0) + 1
    for (who, layer), n in sorted(tally.items(), key=lambda t: -t[1]):
        print('  %-8s layer %-12s %d' % (who, layer, n))
    made = {}
    for x in d:
        if (x.get('made_at') or '').strip():
            made[x['made_at']] = made.get(x['made_at'], 0) + 1
    if made:
        print('made at: ' + ', '.join('%s %d' % kv for kv in sorted(made.items())))


def main(a):
    if not a:
        raise SystemExit(__doc__)
    cmd, rest = a[0], a[1:]
    if cmd == 'check':
        bad = 0
        import sequence   # scope and sequence stage (added 2026-11-14)
        for c in (rest[:1] or courses()):
            if sequence.stage(c) == 'scope':
                fl, nt = sequence.check(c)
                print('sequence %s: %d failure(s)' % (c, len(fl)))
                for x in fl: print('  FAIL', x)
                for x in nt: print('  note', x)
                bad += len(fl)
                continue
            # a course whose days.csv keeps the scope layout (one row per day of the year, an assess column) while its
            # first unit is planned keeps its scope gate (social studies probe, us-history-i unit 5, 2026-11-15)
            if 'assess' in (rows(c, 'days')[:1] or [{}])[0]:
                fl, nt = sequence.check(c)
                print('sequence %s: %d failure(s)' % (c, len(fl)))
                for x in fl: print('  FAIL', x)
                bad += len(fl)
            fails, notes, ni, nw = check(c)
            print('%s: %d items and %d wrong answers checked, %d failure(s)' % (c, ni, nw, len(fails)))
            for x in fails:
                print('  FAIL', x)
            for x in notes:
                print('  note', x)
            bad += len(fails)
            ng = new_gates(c)
            for x in ng:
                print('  FAIL', x)
            bad += len(ng)
        if not rest:
            import progression
            for s in [s for s in progression.STD_FILES if progression.load(s) is not None]:
                pf, pn, n = progression.check(s)
                print('progression %s: %d rows, %d failure(s)' % (s, n, len(pf)))
                for x in pf: print('  FAIL', x)
                for x in pn: print('  note', x)
                bad += len(pf)
            import frame   # course frames (added 2026-11-13)
            cal = frame.calendar_rows()
            gf = frame.check_global()
            print('frames: %d course(s), %d catalogue failure(s)' % (len(frame.found()), len(gf)))
            for x in gf: print('  FAIL', x)
            bad += len(gf)
            for s in frame.found():
                ff, fn = frame.check(s, cal)
                print('frame %s: %d failure(s)' % (s, len(ff)))
                for x in ff: print('  FAIL', x)
                for x in fn: print('  note', x)
                bad += len(ff)
        sys.exit(1 if bad else 0)
    elif cmd == 'tables':
        for c in (rest[:1] or courses()):
            tables(c)
    elif cmd == 'pack':
        pack(rest[0], str(int(rest[1])))
    elif cmd == 'defect':
        defect_add(rest)
    elif cmd == 'reserve':
        reserve(rest[0], str(int(rest[1])))
    elif cmd == 'defects':
        defects()
    else:
        raise SystemExit(__doc__)


if __name__ == '__main__':
    main(sys.argv[1:])

