{"strand": "phw", "grade": "8", "skill_id": "g8-phw-goal-effect", "standard": "NHES.S6.8.6", "assumes": "g7-phw-write-goal-link", "hands_on": "g9-phw-goal-carry-revise", "model_in": "goal-plan", "model_out": "goal-plan", "words": "effect; reflect; well-being", "cross_subject": "", "notes": "Examine how setting the goal affected health and well-being, including what to carry into the next goal. Serves HECAT.PHW.HBO2, HECAT.PHW.HBO7."}
{"strand": "phw", "grade": "8", "skill_id": "g8-phw-habits-personal-community", "standard": "NHES.S7.8.3", "assumes": "g7-phw-sleep-habits-community", "hands_on": "g9-phw-evaluate-habits; g9-pa-habits-ease-adapt; g9-fn-habits-groups", "model_in": "goal-plan", "model_out": "goal-plan", "words": "habit; community; carry out; team", "cross_subject": "", "notes": "Carry out habits that support personal and community wellness (a service of handwashing posters, a walking group, a sleep routine) for several weeks. Serves HECAT.PHW.HBO2, HECAT.PHW.HBO7."}
{"strand": "fn", "grade": "8", "skill_id": "g8-fn-advocacy-audience", "standard": "NHES.S8.8.3", "assumes": "g7-t-advocate-alone-or-group", "hands_on": "g9-v-advocacy-adjust", "model_in": "speak-up-plan", "model_out": "speak-up-plan", "words": "audience; setting; message; proposal", "cross_subject": "ela:W.8.1 (write an argument for an audience)", "notes": "Fit advocacy approaches to the audience and setting: a school lunch ask to a principal, a note to a family, a post for peers. Serves HECAT.FN.HBO12."}
