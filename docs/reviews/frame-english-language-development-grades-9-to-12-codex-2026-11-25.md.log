  if r['kind']=='check':
   clashes=[(c['course'],c['first_school_day'],c['last_school_day']) for c in cal if c['kind']=='check' and c['grade']==grade and c['course']"'!=course and c['"'subject'] in ['math','ela','science','social-studies'] and set(range(int(c['first_week']),int(c['last_week'])+1)) & set(range(int(r['first_week']),int(r['last_week'])+1))]
