import csv,re
from pathlib import Path
cal=list(csv.DictReader(open('data/plans/calendar.csv',encoding='utf-8')))
print('CALENDAR COLUMNS',list(cal[0]))
course='english-language-development-grades-9-to-12'
for grade in ['9','10','11','12']:
 rows=[r for r in cal if r['course']==course and r['grade']==grade]
 print(grade,[(r['kind'],r.get('unit'),r['course_start'],r['course_end'],r['school_start'],r['school_end']) for r in rows])
print('\\nHOST SKILLS')
look={}
for p in Path('docs/courses').glob('*/frame.md'):
 text=p.read_text(encoding='utf-8')
 for line in text.splitlines():
  cells=[x.strip() for x in line.strip().strip('|').split('|')]
  if not line.startswith('|') or not cells[0].isdigit():continue
  unit=cells[0]
  for sk in re.findall(r'\\b(?:e(?:9|10|11|12)|alg1|alg2|geo|bio|chem|phys|wh1|wh2|us1|us2|gov|econ|stat|calc|pc|env|ess)-[a-z0-9-]+\\b',line):
   rs=[r for r in cal if r['course']==p.parent.name and r['kind']=='unit' and r['unit']==unit]
   for r in rs: look.setdefault(sk,set()).add((p.parent.name,unit,r['school_start'],r['school_end']))
for r in csv.DictReader(open('data/progressions/eld.csv',encoding='utf-8')):
 if r['grade'] not in ['9','10','11','12']:continue
 for subj,sk in re.findall(r'([a-z-]+):([a-z0-9-]+)',r['cross_subject']):
  print(r['skill_id'],sk,sorted(look.get(sk,[])))
