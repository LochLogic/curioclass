| 5 | 17, 32 | 11, 22, 31 | 10, 21, 30 | 16, 29 |
| 6 | 12, 22, 32 | 16, 24, 32 | 18, 32 | 15, 23, 32 |
| 7 | 12, 22, 32 | 9, 24, 32 | 14, 32 | 13, 24, 32 |
| 8 | 18, 25 to 26, 32 | 14, 24, 32 | 15, 32 | 10, 20, 29 to 30 |

