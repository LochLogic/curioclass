def run(scope, raw, pats=(), summary=None):
    if raw.exists():
        shutil.rmtree(raw, ignore_errors=True)
    raw.mkdir(parents=True, exist_ok=True)
    jobs = [j for j in gates(scope, raw) if not pats or any(fnmatch.fnmatch(j[0], p) for p in pats)]
    if not jobs:
        raise SystemExit('no gate matches %s' % ' '.join(pats))
    site = raw / 'dist'
    env = dict(os.environ, CURIO_DIST=str(site))

    def one(job):
        name, args = job
        p = subprocess.run(PY + args, cwd=ROOT, capture_output=True, text=True, encoding='utf-8', errors='replace',
                           env=env)
        text = p.stdout + ('\n--- stderr ---\n' + p.stderr if p.stderr.strip() else '')
        (raw / (name + '.txt')).write_text(text, encoding='utf-8')
        last = next((l for l in reversed(text.splitlines()) if l.strip()), '')
        return name, p.returncode, last[:200]

    par = [j for j in jobs if j[0] not in SERIAL and j[0] not in SITE]
    with ThreadPoolExecutor(4) as ex:
        rows = list(ex.map(one, par))
    rows += [one(j) for j in jobs if j[0] in SERIAL]
    names = {j[0] for j in jobs}
    if 'build_site' in names:
        shutil.rmtree(site, ignore_errors=True)
        rows.append(one(('build_site', dict(jobs)['build_site'])))
    if 'check_site' in names:
        if not (site / 'index.html').exists():
            raise SystemExit('check_site needs build_site in the same run')
        rows.append(one(('check_site', ['scripts/check_site.py'])))
    rows.sort()
    for d in [raw] + ([summary] if summary else []):
        d.mkdir(parents=True, exist_ok=True)
        with open(d / 'summary.csv', 'w', encoding='utf-8', newline='') as f:
            w = csv.writer(f)
            w.writerow(['gate', 'exit', 'last_line'])
            w.writerows(rows)
    bad = [r for r in rows if r[1] != 0]
    print('%d gates run into %s; %d exited non-zero: %s' % (len(rows), raw.relative_to(ROOT).as_posix(), len(bad),
                                                           ', '.join(r[0] for r in bad) or 'none'))
    return rows


def rawdir(name):
    """A run folder: build/gates/<name>, or (older consolidation steps) docs/reviews/consolidation/<name>."""
    return RAW / name if (RAW / name).exists() else REVIEWS / name


def lines(p):
WORK = re.compile(
    r"not yet (in the|placed|written|built|added|loaded|in a curio class|named by|decided|chosen)"
    r"|until (it|they|this|that|the [\w ,'-]{1,40}) (is|are) (added|written|built|loaded|placed|decided|chosen)"
    r"|once (it|they|the [\w ,'-]{1,40}) (is|are|exists?) (added|written|built|loaded|placed|decided)"
    r"|\b(?:yet|still|is|are) to come\b|\bTBD\b|\bTODO\b|placeholder|will be (placed|written|added|decided)"
    r"|held here in words", re.I)
_done = None


def done_nodes():
    global _done
    if _done is None:
        _done = set()
        p = os.path.join(ROOT, 'data', 'plans', 'flow-status.csv')
        if os.path.exists(p):
            for r in csv.DictReader(open(p, encoding='utf-8')):
                if r.get('state') == 'done':
                    _done.add(r['node'])
    return _done


def resolved(what):
    """True if landed, False if still waiting, None if the target is not a form the checker knows."""
    what = what.strip()
    path, _, text = what.partition('#')
    if '/' in path or '.' in os.path.basename(path):
        f = os.path.join(ROOT, path)
        if not os.path.exists(f):
            return False
        if not text:
            return True
        return text in open(f, encoding='utf-8', errors='replace').read()
    if ':' in what or re.fullmatch(r'P\d+[a-z]?', what):
        return what in done_nodes()
    return None


def check_text(label, text):
    """Fails for one note. Work-status wording inside a Pending clause (up to the next sentence end) is fine."""
    fails = []
    covered = []
    for m in MARK.finditer(text):
        r = resolved(m.group(1))
        if r is None:
            fails.append('%s: Pending(%s) names no file, file#text or plan node' % (label, m.group(1)))
        elif r:
            fails.append('%s: STALE, Pending(%s) has landed; rewrite the note to say what is now true' % (label, m.group(1)))
        end = text.find('. ', m.end())
        covered.append((m.start(), len(text) if end < 0 else end + 1))
    for m in WORK.finditer(text):
        if not any(a <= m.start() < b for a, b in covered):
            fails.append('%s: work-status wording %r outside a Pending(...) marker' % (label, m.group(0)))
    return fails


def check_file(path):
    rel = os.path.relpath(path, ROOT).replace('\\', '/')
    fails = []
    if path.endswith('.csv'):
        rows = list(csv.DictReader(open(path, encoding='utf-8')))
        for i, r in enumerate(rows, 2):
            key = r.get('skill_id') or r.get('id') or r.get('node') or 'line %d' % i
            for col in ('notes', 'note', 'detail'):
                if r.get(col):
                    fails += check_text('%s %s' % (rel, key), r[col])
    else:
        for i, line in enumerate(open(path, encoding='utf-8'), 1):
            fails += check_text('%s:%d' % (rel, i), line)
    return fails


def default_files():
    pats = ['data/progressions/social-studies.csv', 'data/progressions/science.csv', 'data/progressions/ela.csv',
            'data/progressions/math.csv', 'data/frames/*.csv', 'docs/courses/*/frame.md']
    out = []
    for p in pats:
        out += sorted(glob.glob(os.path.join(ROOT, p)))
    return out


def main(a):
    if not a or a[0] != 'check':
        raise SystemExit(__doc__)
    files = [os.path.join(ROOT, f) for f in a[1:]] or default_files()
    fails = []
    for f in files:
        fails += check_file(f)
    print('stale: %d file(s), %d failure(s)' % (len(files), len(fails)))
    for x in fails:
        print('  FAIL', x)
    sys.exit(1 if fails else 0)


if __name__ == '__main__':
    main(sys.argv[1:])
