# ------------------------------------------------------------------ defect ledger
DEF = PLANS / 'defects.csv'
DEF_COLS = ['date', 'course', 'artifact', 'layer', 'found_by', 'kind', 'summary', 'status', 'ref', 'made_at']
MADE_AT = {'prework', 'progression', 'frame', 'scope', 'unit-plan', 'section-plan', 'plan-data', 'keys', 'day', 'finish', 'kit'}
# made_at (COURSE-RUN section 4): the stage that made the fault, beside found_by/layer, the stage that found it; old rows blank


def rows_defects():
    with io.open(DEF, encoding='utf-8', newline='') as f:
        return list(csv.DictReader(f))


def defect_add(a):
    status = 'open'
    made_at = ''
    for x in [x for x in a if x.startswith('--made-at=')]:
        made_at = x.split('=', 1)[1]
        a = [y for y in a if y != x]
    if made_at and made_at not in MADE_AT:
        raise SystemExit('made_at must be one of: ' + ', '.join(sorted(MADE_AT)))
    for x in [x for x in a if x.startswith('--status=')]:
        status = x.split('=', 1)[1]
        a = [y for y in a if y != x]
    if status not in ('open', 'fixed', 'rejected'):
        raise SystemExit('status must be open, fixed or rejected')
    if len(a) < 6:
        raise SystemExit(__doc__)
    if a[3] not in READERS:
        raise SystemExit('found_by must be one of: ' + ', '.join(sorted(READERS)))
    row = [str(datetime.date.today())] + a[:6] + [status, a[6] if len(a) > 6 else '', made_at]
    with io.open(DEF, encoding='utf-8', newline='') as f:   # an old file lacks the made_at column: add it, old rows blank
        head = next(csv.reader(f), [])
    if head and 'made_at' not in head:
        old = rows_defects()
        with io.open(DEF, 'w', encoding='utf-8', newline='') as f:
            w = csv.writer(f, lineterminator=chr(10))
            w.writerow(head + ['made_at'])
            for r in old:
                w.writerow([r.get(h, '') for h in head] + [''])
    with io.open(DEF, 'a', encoding='utf-8', newline='') as f:
        csv.writer(f, lineterminator='\n').writerow(row)
    print('logged:', row)


def defects():
    d = rows_defects()
    print('%d defects logged, %d open' % (len(d), sum(1 for x in d if x['status'] == 'open')))
    tally = {}
    for x in d:
        tally[(x['found_by'], x['layer'])] = tally.get((x['found_by'], x['layer']), 0) + 1
    for (who, layer), n in sorted(tally.items(), key=lambda t: -t[1]):
        print('  %-8s layer %-12s %d' % (who, layer, n))
    made = {}
    for x in d:
        if (x.get('made_at') or '').strip():
            made[x['made_at']] = made.get(x['made_at'], 0) + 1
    if made:
        print('made at: ' + ', '.join('%s %d' % kv for kv in sorted(made.items())))


def main(a):
    if not a:
        raise SystemExit(__doc__)
    cmd, rest = a[0], a[1:]
    if cmd == 'check':
        bad = 0
        import sequence   # scope and sequence stage (added 2026-11-14)
        for c in (rest[:1] or courses()):
            if sequence.stage(c) == 'scope':
                fl, nt = sequence.check(c)
                print('sequence %s: %d failure(s)' % (c, len(fl)))
                for x in fl: print('  FAIL', x)
                for x in nt: print('  note', x)
                bad += len(fl)
                continue
            # a course whose days.csv keeps the scope layout (one row per day of the year, an assess column) while its
            # first unit is planned keeps its scope gate (social studies probe, us-history-i unit 5, 2026-11-15)
            if 'assess' in (rows(c, 'days')[:1] or [{}])[0]:
                fl, nt = sequence.check(c)
                print('sequence %s: %d failure(s)' % (c, len(fl)))
                for x in fl: print('  FAIL', x)
                bad += len(fl)
            fails, notes, ni, nw = check(c)
            print('%s: %d items and %d wrong answers checked, %d failure(s)' % (c, ni, nw, len(fails)))
            for x in fails:
                print('  FAIL', x)
            for x in notes:
                print('  note', x)
            bad += len(fails)
            ng = new_gates(c)
            for x in ng:
                print('  FAIL', x)
            bad += len(ng)
        if not rest:
            import progression
            for s in [s for s in progression.STD_FILES if progression.load(s) is not None]:
                pf, pn, n = progression.check(s)
                print('progression %s: %d rows, %d failure(s)' % (s, n, len(pf)))
                for x in pf: print('  FAIL', x)
                for x in pn: print('  note', x)
                bad += len(pf)
            import frame   # course frames (added 2026-11-13)
            cal = frame.calendar_rows()
            gf = frame.check_global()
            print('frames: %d course(s), %d catalogue failure(s)' % (len(frame.found()), len(gf)))
            for x in gf: print('  FAIL', x)
            bad += len(gf)
            for s in frame.found():
                ff, fn = frame.check(s, cal)
                print('frame %s: %d failure(s)' % (s, len(ff)))
                for x in ff: print('  FAIL', x)
                for x in fn: print('  note', x)
                bad += len(ff)
        sys.exit(1 if bad else 0)
    elif cmd == 'tables':
        for c in (rest[:1] or courses()):
            tables(c)
    elif cmd == 'pack':
        pack(rest[0], str(int(rest[1])))
    elif cmd == 'defect':
        defect_add(rest)
    elif cmd == 'reserve':
        reserve(rest[0], str(int(rest[1])))
    elif cmd == 'defects':
        defects()
    else:
        raise SystemExit(__doc__)


if __name__ == '__main__':
    main(sys.argv[1:])
