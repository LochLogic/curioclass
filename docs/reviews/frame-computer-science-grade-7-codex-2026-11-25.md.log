def run(scope, raw, pats=(), summary=None):
    if raw.exists():
        shutil.rmtree(raw, ignore_errors=True)
    raw.mkdir(parents=True, exist_ok=True)
    jobs = [j for j in gates(scope, raw) if not pats or any(fnmatch.fnmatch(j[0], p) for p in pats)]
    if not jobs:
        raise SystemExit('no gate matches %s' % ' '.join(pats))
    site = raw / 'dist'
    env = dict(os.environ, CURIO_DIST=str(site))

    def one(job):
        name, args = job
        p = subprocess.run(PY + args, cwd=ROOT, capture_output=True, text=True, encoding='utf-8', errors='replace',
                           env=env)
        text = p.stdout + ('\n--- stderr ---\n' + p.stderr if p.stderr.strip() else '')
        (raw / (name + '.txt')).write_text(text, encoding='utf-8')
        last = next((l for l in reversed(text.splitlines()) if l.strip()), '')
        return name, p.returncode, last[:200]

    par = [j for j in jobs if j[0] not in SERIAL and j[0] not in SITE]

def sync():
    have = found()
    out = {s: row_of(s) for s in have}
    with open(FRAMES_CSV, 'w', encoding='utf-8', newline='') as fh:
        w = csv.DictWriter(fh, COLS, lineterminator='\n')
        w.writeheader()
        for k in sorted(out):
            w.writerow(out[k])
    print('frames.csv: %d course(s)' % len(out))
    cal = calendar_rows()
    write_calendar(cal)
    print('calendar.csv: %d row(s), %d course(s)' % (len(cal), len({r['course'] for r in cal})))


def main(a):
    if a[:1] == ['sync']:
        return sync()
    if a[:1] == ['calendar']:
        cal = calendar_rows()
        for g, subs in sorted(check_weeks(cal).items(), key=lambda kv: (kv[0] != 'K', int(kv[0]) if kv[0] != 'K' else 0)):
            print('grade %s: %s' % (g, '; '.join('%s weeks %s' % (s, ', '.join(str(w) for w, _, _ in ws))
                                                  for s, ws in sorted(subs.items()))))
        for g, w, ss in clashes(cal):
            print('  clash: grade %s %s: %s' % (g, w, ', '.join(ss)))
        return
    if a[:1] != ['check']:
        raise SystemExit(__doc__)
    bad = 0
    cal = calendar_rows()
    if not a[1:]:
        for x in check_global():
            print('  FAIL', x)
            bad += 1
    skip = set() if a[1:] else writing()
    if skip:
        print('  note %d frame(s) being written are skipped here (build/frames-writing.txt); check each by name' % len(skip))
    for s in a[1:] or [x for x in found() if x not in skip]:
        fails, notes = check(s, cal)
        print('frame %s: %d failure(s)' % (s, len(fails)))
        for x in fails:
            print('  FAIL', x)
        for x in notes:
            print('  note', x)
        bad += len(fails)
    sys.exit(1 if bad else 0)


if __name__ == '__main__':
    main(sys.argv[1:])

