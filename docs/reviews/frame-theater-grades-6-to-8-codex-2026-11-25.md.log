                for x in fl: print('  FAIL', x)
                bad += len(fl)
            fails, notes, ni, nw = check(c)
            print('%s: %d items and %d wrong answers checked, %d failure(s)' % (c, ni, nw, len(fails)))
            for x in fails:
                print('  FAIL', x)
            for x in notes:
