272: def meeting(slug, f):
273:     """(weeks the course meets, the school day its year starts after, lessons a week)."""
274:     days = f['days'] or YEAR_DAYS
275:     if slug in TERM:
276:         return YEAR_WEEKS // 2, (0 if TERM[slug] == 'fall' else YEAR_DAYS // 2), 5
277:     years = max(1, len(f.get('years') or []))                   # a band course runs its years one after another
278:     days = math.ceil(days / years)
279:     weeks = YEAR_WEEKS
