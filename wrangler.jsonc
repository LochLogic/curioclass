// Curio Class: static site served by Cloudflare Workers static assets (no Worker code).
// Build first: python scripts/build_site.py ; then: npx wrangler deploy
{
  "name": "curioclass",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "curioclass.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
